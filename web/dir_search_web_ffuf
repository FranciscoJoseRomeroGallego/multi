# ----------------------------------------------------------------
# DEFAULT DE EXTENSIONES
# ----------------------------------------------------------------

apply_default_extensions() {

    for ((i=0; i<${#extensions_list[@]}; i++)); do
        selected[$i]=0
    done

    for default_ext in "${default_extensions[@]}"; do

        for ((i=0; i<${#extensions_list[@]}; i++)); do

            if [[ "${extensions_list[$i]}" == "$default_ext" ]]; then
                selected[$i]=1
                break
            fi

        done

    done
}


# ----------------------------------------------------------------
