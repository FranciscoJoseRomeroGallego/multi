# ----------------------------------------------------------------

draw_extension_menu() {

    clear

    echo
    echo "╔══════════════════════════════════════════════════════════════════════╗"
    echo "║                       SELECCIONAR EXTENSIONES                       ║"
    echo "╠══════════════════════════════════════════════════════════════════════╣"
    echo "║                                                                      ║"
    echo "║   ↑ ↓       Mover                                                    ║"
    echo "║   SPACE     Seleccionar / deseleccionar                              ║"
    echo "║   ENTER     Confirmar                                                 ║"
    echo "║   Q         Cancelar                                                  ║"
    echo "║                                                                      ║"
    echo "╠══════════════════════════════════════════════════════════════════════╣"


    if ((cursor == 0)); then
        printf "║  ➜  [DEFAULT]  .php,.html,.txt,.bak,.js                            ║\n"
    else
        printf "║     [DEFAULT]  .php,.html,.txt,.bak,.js                             ║\n"
    fi


    for ((i=0; i<${#extensions_list[@]}; i++)); do

        index=$((i + 1))

        if ((cursor == index)); then
            prefix="➜"
        else
            prefix=" "
        fi

        if ((selected[$i] == 1)); then
            checkbox="[X]"
        else
            checkbox="[ ]"
        fi

        printf "║  %s  %s .%-57s ║\n" \
            "$prefix" \
            "$checkbox" \
            "${extensions_list[$i]}"

    done


    echo "╠══════════════════════════════════════════════════════════════════════╣"

    selected_display=""

    for ((i=0; i<${#extensions_list[@]}; i++)); do

        if ((selected[$i] == 1)); then

            if [[ -z "$selected_display" ]]; then
                selected_display=".${extensions_list[$i]}"
            else
                selected_display="$selected_display,.${extensions_list[$i]}"
            fi

        fi

    done


    if [[ -z "$selected_display" ]]; then

        printf "║  Seleccionadas: ninguna                                              ║\n"

    else

        if (( ${#selected_display} > 58 )); then
            selected_preview="${selected_display:0:55}..."
        else
            selected_preview="$selected_display"
        fi

        printf "║  Seleccionadas: %-57s ║\n" "$selected_preview"

    fi


    echo "╚══════════════════════════════════════════════════════════════════════╝"
}


# ----------------------------------------------------------------
# SELECTOR INTERACTIVO DE EXTENSIONES
# ----------------------------------------------------------------

extension_selector() {

    extensions_list=(
        "php"
        "html"
        "htm"
        "txt"
        "js"
        "json"
        "xml"
        "css"
        "bak"
        "old"
        "backup"
        "zip"
        "tar"
        "gz"
        "sql"
        "conf"
        "config"
        "ini"
        "log"
        "env"
        "yml"
        "yaml"
        "asp"
        "aspx"
        "jsp"
        "cgi"
        "pl"
        "py"
        "rb"
        "sh"
    )


    default_extensions=(
        "php"
        "html"
        "txt"
        "bak"
        "js"
    )


    declare -a selected


    for ((i=0; i<${#extensions_list[@]}; i++)); do
        selected[$i]=0
    done


    apply_default_extensions

    cursor=0
    total=$((${#extensions_list[@]} + 1))


    while true; do

        draw_extension_menu

        IFS= read -rsn1 key

        case "$key" in

            "")
                break
                ;;

            " ")

                if ((cursor == 0)); then

                    apply_default_extensions

                else

                    index=$((cursor - 1))

                    if ((selected[$index] == 1)); then
                        selected[$index]=0
                    else
                        selected[$index]=1
                    fi

                fi

                ;;

            q|Q)

                return 1
                ;;

            $'\x1b')

                IFS= read -rsn2 key

                case "$key" in

                    "[A")

                        ((cursor--))

                        if ((cursor < 0)); then
                            cursor=$((total - 1))
                        fi

                        ;;

                    "[B")

                        ((cursor++))

                        if ((cursor >= total)); then
                            cursor=0
                        fi

                        ;;

                esac

                ;;

        esac

    done


    extensions=""

    for ((i=0; i<${#extensions_list[@]}; i++)); do

        if ((selected[$i] == 1)); then

            if [[ -z "$extensions" ]]; then
                extensions=".${extensions_list[$i]}"
            else
                extensions="$extensions,.${extensions_list[$i]}"
            fi

        fi

    done


    if [[ -z "$extensions" ]]; then

        clear

        echo
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║                                                          ║"
        echo "║      ❌ NO HAS SELECCIONADO EXTENSIONES ❌             ║"
        echo "║                                                          ║"
        echo "║      Debes seleccionar al menos una extensión.          ║"
        echo "║                                                          ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo

        sleep 2

        extension_selector
        return $?

    fi


    extensions_display="$extensions"

    return 0
}


