# CONSTRUIR ARGUMENTOS FFUF
# ----------------------------------------------------------------

if [[ "$search_mode_name" == "POST PARAMETER" ]]; then

    # ============================================================
    # POST PARAMETER
    # ============================================================

    ffuf_args=(

        -u "$post_url"

        -X POST

        -H "Content-Type: application/x-www-form-urlencoded"

        -d "${post_param}=FUZZ"

        -w "$tmp_wordlist"

        -t "$threads"

        -v

        -mc all

        -of json

        -o "$tmp_json"

        -noninteractive

    )

else

    # ============================================================
    # WEB NORMAL
    # ============================================================

    ffuf_args=(

        -u "$url"

        -w "$tmp_wordlist"

        -t "$threads"

        -mc 200,204,301,302,307,401,403,405,500

        -of json

        -o "$tmp_json"

        -noninteractive

        -recursion

    )

fi


# ----------------------------------------------------------------
# RATE
# ----------------------------------------------------------------

if ((rate > 0)); then

    ffuf_args+=(
        -rate "$rate"
    )

fi


# ----------------------------------------------------------------
# DELAY
# ----------------------------------------------------------------

if [[ -n "$delay" ]]; then

    ffuf_args+=(
        -p "$delay"
    )

fi


# ----------------------------------------------------------------
# ARCHIVOS
# ----------------------------------------------------------------

if [[ "$search_mode_name" == "WEB" && "$search_type_name" == "ARCHIVOS" ]]; then

    ffuf_args+=(
        -e "$extensions"
        -v
    )

fi


# ----------------------------------------------------------------
# EJECUTAR
# ----------------------------------------------------------------

ffuf "${ffuf_args[@]}"


# ----------------------------------------------------------------
# RESULTADOS
# ----------------------------------------------------------------

clear

echo
echo "╔══════════════════════════════════════════════════════════════════════╗"
echo "║                         RESULTADOS ENCONTRADOS                      ║"
echo "╠══════════════════════════════════════════════════════════════════════╣"
echo

printf "%-35s %-8s %-10s %s\n" \
    "ENCONTRADO" \
    "STATUS" \
    "SIZE" \
    "URL"

echo "────────────────────────────────────────────────────────────────────────────────"


# ----------------------------------------------------------------
# EXTRAER RESULTADOS DEL JSON
# ----------------------------------------------------------------

if [[ "$search_mode_name" == "POST PARAMETER" ]]; then

    # ------------------------------------------------------------
    # POST PARAMETER
    # SOLO MOSTRAR HTTP 200
    # ------------------------------------------------------------

    results=$(jq -r '
        .results[]
        | select(.url != null)
        | select(.url != "")
        | select(.status == 200)
        | [
            (.input.FUZZ // "-"),
            (.status // "-"),
            (.length // "-"),
            .url
          ]
        | @tsv
    ' "$tmp_json" 2>/dev/null)

else

    # ------------------------------------------------------------
    # WEB NORMAL
    # MANTENER TODOS LOS RESULTADOS COMO ANTES
    # ------------------------------------------------------------

    results=$(jq -r '
        .results[]
        | select(.url != null)
        | select(.url != "")
        | [
            (.input.FUZZ // "-"),
            (.status // "-"),
            (.length // "-"),
            .url
          ]
        | @tsv
    ' "$tmp_json" 2>/dev/null)

fi


# ----------------------------------------------------------------
# MOSTRAR RESULTADOS
# ----------------------------------------------------------------

if [[ -z "$results" ]]; then

    echo
    echo "                         No se encontraron resultados."
    echo

else

    while IFS=$'\t' read -r found status size result_url; do

        printf "%-35s %-8s %-10s %s\n" \
            "$found" \
            "$status" \
            "$size" \
            "$result_url"

    done <<< "$results"

fi


echo
echo "════════════════════════════════════════════════════════════════════════════════"
echo